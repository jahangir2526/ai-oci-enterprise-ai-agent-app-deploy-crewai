# OCI region containing the Generative AI project, API key, and model.
OCI_REGION=us-ashburn-1

# Required OCI Generative AI project OCID.
OCI_GENAI_PROJECT_OCID=ocid1.generativeaiproject.oc1.<region>.<unique-id>

# Required OCI Generative AI API key. Never commit a real key.
OCI_GENAI_API_KEY=<your-oci-generative-ai-api-key>

# Optional OCI Responses API model ID.
OCI_CHAT_MODEL=xai.grok-4.3
